# =============================================================================
# webrd3 — environment variable template
# =============================================================================
# Copy this file to `.env` for local development. Production values are injected
# on the deployment server only — DO NOT commit real credentials.
# -----------------------------------------------------------------------------

# ---- Application ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL via Prisma) ---------------------------------------
# Server-allocated port from pool 54321~54399.
DATABASE_URL=postgresql://webrd3:CHANGE_ME@127.0.0.1:54321/webrd3?schema=public

# ---- Redis (BullMQ + sessions + rate limit) ---------------------------------
# Server-allocated port from pool 63791~63800.
REDIS_URL=redis://127.0.0.1:63791

# ---- Auth -------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=2h

# ---- Alibaba Cloud OSS (image upload) ---------------------------------------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=chorify-nova
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_PUBLIC_DOMAIN=oss3.sligenai.cn

# ---- Aliyun SMS (verification codes) ----------------------------------------
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_REGION_ID=cn-hangzhou

# ---- WebSocket endpoint exposed to the browser ------------------------------
NEXT_PUBLIC_WS_URL=ws://localhost:3000
